# The TURN server is provided by the official coturn image.
# No custom build is needed — use it directly in docker-compose:
#
#   turn:
#     image: coturn/coturn:latest
#     command: >
#       -n --log-file=stdout
#       --user=user:password
#       --realm=videochat
#       --min-port=49152 --max-port=65535
#
# See containers/composes/dc.dev.yml and dc.prod.yml for the full config.
FROM coturn/coturn:latest
